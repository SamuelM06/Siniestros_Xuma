# ============================================================
# PLANTILLA PUBLICA DE VARIABLES DE ENTORNO
# Copia este archivo como .env y rellena los valores reales:
#   cp .env.example .env
# NUNCA subas tus credenciales reales a GitHub.
# ============================================================

DB_HOST=localhost
DB_PORT=5432
# Base de datos de siniestros (configurar según entorno)
DB_NAME=tu_base_datos
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
# DB_SSL puede ser true si el servidor exige conexión cifrada
# Tope de conexiones de este despliegue (la BD admite pocas y las comparten varias apps)
DB_POOL_MAX=5
DB_SSL=false

# Puerto del servidor de desarrollo
PORT=4321

# ============================================================
# SEGURIDAD / ACCESO
# ============================================================

# Usuario del portal
ADMIN_USER=admin
# Hash de contraseña (generar con tu método preferido)
ADMIN_PASSWORD_HASH=tu_hash_aqui
# Clave secreta para firmar sesiones (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=tu_secreto_aqui
# Duración de la sesión en horas
AUTH_TTL_HOURS=12

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=600000
RATE_LIMIT_API_MAX=180
RATE_LIMIT_API_WINDOW_MS=60000

# =============================================================================
# SESIÓN DEL HUB (web pública y red interna)
# =============================================================================
# true SOLO en el despliegue público. Vacío (red interna) = sin cambios, sin exigir sesión del Hub.
REQUIRE_HUB_SESSION=
# El mismo JWT_SECRET que usa el Hub (firma la cookie xuma_session). Vacío en producción = nadie entra.
JWT_SECRET=
# id_persona autorizados, separados por coma. Vacío = nadie entra.
ALLOWED_PERSONAS=
# Subruta pública, p. ej. /siniestros (se fija al COMPILAR; vacío = raíz, para local)
BASE_PATH=
# Solo desarrollo local: true salta la validación de sesión. Se ignora en producción.
AUTH_DEV=
