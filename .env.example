# ============================================================
# PLANTILLA PUBLICA DE VARIABLES DE ENTORNO
# Copia este archivo como .env y rellena los valores reales:
#   cp .env.example .env
# NUNCA subas tus credenciales reales a GitHub.
# ============================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tu_base_de_datos
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña_aqui
# DB_SSL puede ser true si el servidor exige conexión cifrada
DB_SSL=false

# Puerto del servidor de desarrollo
PORT=4321

# ============================================================
# SEGURIDAD / ACCESO (valores ficticios de ejemplo)
# ============================================================

# Usuario del portal
ADMIN_USER=analista
# Hash scrypt de la contraseña (generar con: npm run set-password)
ADMIN_PASSWORD_HASH=sal_random_aqui:hash_hex_aqui
# Clave secreta para firmar sesiones (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=pon_un_secreto_largo_aleatorio_aqui
# Duración de la sesión en horas
AUTH_TTL_HOURS=12

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=600000
RATE_LIMIT_API_MAX=180
RATE_LIMIT_API_WINDOW_MS=60000