---
import MainLayout from './MainLayout.astro';
import LogoutButton from '../components/ui/LogoutButton.tsx';
import ThemeToggle from '../components/ui/ThemeToggle.tsx';

interface Props {
  title?: string;
}
const { title = 'Siniestros Xuma 2026' } = Astro.props;

const svgTablero =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/></svg>';
const svgLista =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>';

const nav = [
  {
    href: '/',
    label: 'Inicio',
    svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
  },
  { href: '/dashboard', label: 'Dashboard', svg: svgTablero },
  { href: '/detalle', label: 'Detalle', svg: svgLista },
];
const actual = Astro.url.pathname;

const botonTop =
  'inline-flex h-10 cursor-pointer items-center justify-center gap-2 rounded-xl glass px-3.5 text-sm font-semibold text-tinta/85 transition-colors hover:bg-tinta/10';
---

<MainLayout title={title}>
  <header class="topbar sticky top-0 z-40 backdrop-blur-xl">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2 md:px-8">
      <a href="/" class="flex items-center gap-3" aria-label="Volver al inicio">
        <img
          src="/logos/Transparente_Logo_azul_letra_azul.svg"
          alt="Xuma"
          class="h-10 w-auto md:h-12 dark:hidden"
        />
        <img
          src="/logos/Transparente_Logo_blanco_letra_blanca.svg"
          alt="Xuma"
          class="hidden h-10 w-auto md:h-12 dark:block"
        />
        <span class="hidden text-sm font-bold tracking-wide text-tinta/85 sm:block">
          Tablero de Siniestros <span class="text-xuma-verde-oscuro dark:text-xuma-verde-claro">2026</span>
        </span>
      </a>

      <nav class="flex items-center gap-1 rounded-2xl glass p-1">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class={`inline-flex items-center gap-1.5 rounded-xl px-3 py-1.5 text-sm font-semibold transition-all duration-300 md:px-4 ${
                actual === item.href || actual === `${item.href}/`
                  ? 'bg-xuma-verde-claro/90 text-[#0a1030] shadow-lg shadow-xuma-verde-claro/25'
                  : 'text-tinta/75 hover:bg-tinta/10 hover:text-tinta'
              }`}
            >
              <span set:html={item.svg} />
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <span class={`${botonTop} hidden md:inline-flex`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-xuma-verde-oscuro dark:text-xuma-verde-claro"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          Sesión segura
        </span>
        <ThemeToggle client:load />
        <LogoutButton client:load />
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-3 md:px-8 md:py-4">
    <slot />
  </main>
</MainLayout>
