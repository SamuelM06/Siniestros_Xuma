---
import MainLayout from './MainLayout.astro';
import ThemeToggle from '../components/ui/ThemeToggle.tsx';

interface Props {
  title?: string;
}
const { title = 'Gestión de Siniestros | Promigas' } = Astro.props;

const svgTablero =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/></svg>';
const svgLista =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>';
const svgEstatus =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect width="17" height="6" x="2" y="3" rx="2"/><rect width="9" height="6" x="14" y="15" rx="2"/><path d="M10 6h11"/><path d="M2 18h3"/><path d="M7 12h9"/></svg>';
const svgMapa =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/></svg>';
const svgHistoricos =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>';

const svgProyeccion =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>';

const nav = [
  {
    href: '/',
    label: 'Inicio',
    svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
  },
  { href: '/dashboard', label: 'Dashboard', svg: svgTablero },
  { href: '/mapa', label: 'Mapa Siniestros', svg: svgMapa },
  { href: '/estatus', label: 'Estatus Siniestros', svg: svgEstatus },
  { href: '/detalle', label: 'Detalle', svg: svgLista },
  { href: '/historicos', label: 'Históricos', svg: svgHistoricos },
  { href: '/proyeccion', label: 'Proyección', svg: svgProyeccion },
];
const actual = Astro.url.pathname;
---

<MainLayout title={title}>
  <slot name="head" slot="head" />
  <header class="topbar sticky top-0 z-40 backdrop-blur-xl">
    <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 px-3 py-1.5 md:px-6">
      <a href="/" class="flex items-center gap-2.5 justify-self-start" aria-label="Volver al inicio">
        <img
          src="/logos/Transparente_Logo_azul_letra_azul.svg"
          alt="Xuma"
          class="h-9 w-auto md:h-10 dark:hidden"
        />
        <img
          src="/logos/Transparente_Logo_blanco_letra_blanca.svg"
          alt="Xuma"
          class="hidden h-9 w-auto md:h-10 dark:block"
        />
        <span class="hidden text-sm font-bold tracking-wide text-tinta/85 sm:block">
          Gestión de Siniestros <span class="text-xuma-verde-oscuro dark:text-xuma-verde-claro">| Promigas</span>
        </span>
      </a>

      <nav class="flex min-w-0 items-center justify-self-center gap-1 rounded-2xl glass p-1">
        {
          nav.map((item) => (
            <a
              href={item.href}
              data-astro-prefetch="hover"
              class={`inline-flex items-center gap-1.5 rounded-xl px-3 py-1.5 text-xs font-semibold transition-all duration-300 md:text-sm md:px-3.5 ${
                actual === item.href || actual === `${item.href}/`
                  ? 'bg-xuma-verde-claro/90 text-[#0a1030] shadow-lg shadow-xuma-verde-claro/25'
                  : 'text-tinta/75 hover:bg-tinta/10 hover:text-tinta'
              }`}
            >
              <span set:html={item.svg} />
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center justify-end gap-2 justify-self-end">
        <ThemeToggle client:load />
      </div>
    </div>
  </header>

  <main class="mx-auto w-full max-w-[1720px] px-2.5 py-2 sm:px-4">
    <slot />
  </main>
</MainLayout>
