---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import ProyeccionApp from '../components/proyeccion/ProyeccionApp.tsx';
import { filtrosPorDefecto, getProyeccion, getMetadatos } from '../lib/query';

const f = filtrosPorDefecto();
const rangoHist = { ...f, desde: '2018-01-01', hasta: '2025-12-31' };
const [proyeccion, metadatos] = await Promise.all([
  getProyeccion(f),
  getMetadatos(rangoHist),
]);
---
<DashboardLayout title="Proyección · Gestión de Siniestros | Promigas">
  <ProyeccionApp
    client:load
    datosIniciales={proyeccion}
    filtrosIniciales={f}
    metadatos={metadatos}
  />
</DashboardLayout>