---
import { ruta } from '../lib/base';
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { filtrosPorDefecto, getMetadatos } from '../lib/query';
import { mesLabel } from '../utils/formatters';

const f = filtrosPorDefecto();
const metadatos = await getMetadatos(f);
const maxFecha = metadatos?.rangoFechas?.max ?? '2026-08-31';
const actualizado = mesLabel(maxFecha.slice(0, 7));

const iconos = {
  trofeo:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>',
  tendencia:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>',
  dona:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>',
  busqueda:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>',
  tablero:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/></svg>',
  lista:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>',
  calendario:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>',
  ayuda:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>',
};

const pilares = [
  {
    icon: iconos.trofeo,
    titulo: 'KPIs del periodo',
    desc: 'Total de siniestros, pagados, objetados, solicitud de documentos y total pagado en pesos.',
  },
  {
    icon: iconos.tendencia,
    titulo: 'Tendencias mensuales',
    desc: 'Evolución de los siniestros y montos mes a mes con gráficos animados.',
  },
  {
    icon: iconos.dona,
    titulo: 'Participación',
    desc: 'Porciones por aseguradora, gasera y producto para ver quién concentra la operación.',
  },
  {
    icon: iconos.busqueda,
    titulo: 'Filtros y detalle',
    desc: 'Contrato, fechas, mes, gasera y producto con tabla de detalle paginada y exportable.',
  },
];
---
<DashboardLayout title="Inicio · Gestión de Siniestros | Promigas">
  <div class="flex min-h-[calc(100dvh-8rem)] flex-col justify-center gap-6">
    <section class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="show fade-up" style="animation-delay:0.05s">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <p class="inline-flex items-center gap-2 rounded-full border border-xuma-verde-claro/30 bg-xuma-verde-claro/10 px-4 py-1.5 text-xs font-bold tracking-widest text-xuma-verde-oscuro uppercase dark:text-xuma-verde-claro">
            <span class="h-2 w-2 animate-pulse rounded-full bg-xuma-verde-oscuro dark:bg-xuma-verde-claro"></span>
            Reporte anual · 2026
          </p>
          <p class="inline-flex items-center gap-2 rounded-full border border-xuma-violeta/40 bg-xuma-violeta/10 px-4 py-1.5 text-xs font-bold text-[#5b3df0] dark:text-[#b8c0ff]">
            <span set:html={iconos.calendario} />
            Última actualización: {actualizado}
          </p>
        </div>
        <h1 class="text-3xl font-extrabold leading-tight md:text-4xl lg:text-5xl">
          Gestión de <span class="texto-brillo">Siniestros</span>
          <br />
          <span class="text-tinta/85">Promigas</span>
        </h1>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-tinta/65 md:text-base">
          Este portal consolida los siniestros reportados durante
          <strong class="text-tinta"> 2026</strong> por las aseguradoras aliadas
          <strong class="text-tinta"> (Alfa, Cardif, Sura, HDI y Proexequial)</strong>,
          organizados por gasera, de partamento y producto, para tomar decisiones más rápidas.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href={ruta('/dashboard')}
            class="group inline-flex h-12 items-center gap-2 rounded-2xl bg-xuma-azul px-6 font-bold text-white shadow-lg shadow-xuma-azul/20 transition-all duration-300 hover:scale-105 hover:bg-xuma-azul-2 dark:bg-xuma-verde-claro dark:text-[#0a1030] dark:shadow-xl dark:shadow-xuma-verde-claro/25 dark:hover:bg-xuma-verde-oscuro"
          >
            <span set:html={iconos.tablero} />
            Ver tablero
            <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
          <a
            href={ruta('/mapa')}
            class="glass glass-hover inline-flex h-12 items-center gap-2 rounded-2xl px-5 font-semibold text-tinta"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-xuma-verde-oscuro dark:text-xuma-verde-claro"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/></svg>
            Mapa territorial
          </a>
          <a
            href={ruta('/detalle')}
            class="glass glass-hover inline-flex h-12 items-center gap-2 rounded-2xl px-5 font-semibold text-tinta"
          >
            <span set:html={iconos.lista} />
            Ver detalle
          </a>
        </div>
      </div>

      <div class="hidden justify-center lg:flex">
        <div class="show scale-in relative" style="animation-delay:0.2s">
          <img
            src={ruta('/logos/Transparente_Logo_azul_letra_azul.svg')}
            alt="Xuma"
            class="w-56 opacity-90 drop-shadow-[0_0_60px_rgba(18,1,128,0.25)] md:w-64 dark:hidden"
          />
          <img
            src={ruta('/logos/Transparente_Logo_blanco_letra_blanca.svg')}
            alt="Xuma"
            class="hidden w-56 opacity-90 drop-shadow-[0_0_60px_rgba(90,226,128,0.35)] md:w-64 dark:block"
          />
        </div>
      </div>
    </section>

    <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {pilares.map((p, i) => (
        <article
          class="glass glass-hover show fade-up rounded-3xl p-5"
          style={`animation-delay:${0.15 + i * 0.12}s`}
        >
          <div class="mb-3 inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-tinta/10 text-xuma-verde-oscuro dark:text-xuma-verde-claro">
            <span set:html={p.icon} />
          </div>
          <h3 class="text-base font-bold text-tinta">{p.titulo}</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-tinta/60">{p.desc}</p>
        </article>
      ))}
    </section>

    <section class="glass rounded-3xl p-5 md:p-6">
      <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
        <div class="max-w-2xl">
          <h2 class="flex items-center gap-2 text-lg font-bold text-tinta">
            <span class="text-xuma-verde-oscuro dark:text-xuma-verde-claro" set:html={iconos.ayuda} />
            ¿Cómo leer este reporte?
          </h2>
          <p class="mt-2 text-xs leading-relaxed text-tinta/65 md:text-sm">
            Los datos provienen de la base corporativa <code class="rounded-md bg-tinta/10 px-2 py-0.5 text-xuma-verde-oscuro dark:text-xuma-verde-claro">DataCenter_Promigas · esquema siniestros</code>.
            El reporte se centra en la fecha de radicación del siniestro dentro de 2026. Cada estado del
            proceso (pagado, objetado, solicitud de documentos, trámite…) se agrupa en categorías
            internas para facilitar la lectura.
          </p>
        </div>
        <a
          href={ruta('/dashboard')}
          class="glass glass-hover inline-flex h-11 items-center gap-2 rounded-2xl px-5 text-sm font-semibold text-tinta"
        >
          <span set:html={iconos.tablero} />
          Ir al dashboard
        </a>
      </div>
    </section>
  </div>

  <style>
    .show { opacity: 0; }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
    @keyframes scaleIn { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
    @media (prefers-reduced-motion: reduce) {
      .show { opacity: 1; }
    }
    .fade-up { animation: fadeUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .scale-in { animation: scaleIn 1s cubic-bezier(0.22, 1, 0.36, 1) both; }
  </style>
</DashboardLayout>
