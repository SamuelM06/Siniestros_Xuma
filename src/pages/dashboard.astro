---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardApp from '../components/dashboard/DashboardApp.tsx';
import { filtrosPorDefecto, getKpis, getTendencia, getPorAseguradora, getPorGasera, getPorProducto, getMetadatos } from '../lib/query';

const f = filtrosPorDefecto();
const [kpis, tendencia, porAseguradora, porGasera, porProducto, metadatos] = await Promise.all([
  getKpis(f),
  getTendencia(f),
  getPorAseguradora(f),
  getPorGasera(f),
  getPorProducto(f),
  getMetadatos(f),
]);
---
<DashboardLayout title="Dashboard · Siniestros Xuma 2026">
  <DashboardApp
    client:load
    datosIniciales={{ kpis, tendencia, porAseguradora, porGasera, porProducto, metadatos }}
    filtrosIniciales={f}
  />
</DashboardLayout>