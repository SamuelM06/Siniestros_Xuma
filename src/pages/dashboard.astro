---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import DashboardApp from "../components/dashboard/DashboardApp.tsx";
import {
  filtrosPorDefecto,
  getKpis,
  getTendencia,
  getPorAseguradora,
  getPorGasera,
  getPorProducto,
  getPorTipoSiniestro,
  getMetadatos,
} from "../lib/query";

const f = filtrosPorDefecto();
const [kpis, tendencia, porAseguradora, porGasera, porProducto, porTipoSiniestro, metadatos] =
  await Promise.all([
    getKpis(f),
    getTendencia(f),
    getPorAseguradora(f),
    getPorGasera(f),
    getPorProducto(f),
    getPorTipoSiniestro(f),
    getMetadatos(f),
  ]);
---

<DashboardLayout title="Dashboard · Gestión de Siniestros | Promigas">
  <DashboardApp
    client:load
    datosIniciales={{
      kpis,
      tendencia,
      porAseguradora,
      porGasera,
      porProducto,
      porTipoSiniestro,
      metadatos,
    }}
    filtrosIniciales={f}
  />
</DashboardLayout>
